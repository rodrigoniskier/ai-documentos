{
  "name": "rn-video-factory",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Fábrica automatizada de vídeos institucionais com publicação manual assistida.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "tsx src/app.ts",
    "generate": "tsx src/app.ts --generate",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "openai": "^6.49.0",
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
